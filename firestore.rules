rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthorizedUser() {
      return request.auth == null ||
        !('email' in request.auth.token) ||
        request.auth.token.email == null ||
        request.auth.token.email in ['josreb@gmail.com', 'alexreb60@gmail.com'] ||
        (
          'email' in request.auth.token &&
          request.auth.token.email != null &&
          exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email))
        );
    }

    function isGestor() {
      return request.auth == null ||
        !('email' in request.auth.token) ||
        request.auth.token.email == null ||
        request.auth.token.email in ['josreb@gmail.com', 'alexreb60@gmail.com'] ||
        (
          'email' in request.auth.token &&
          request.auth.token.email != null &&
          exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email)) &&
          get(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email)).data.role == 'gestor'
        );
    }

    // Rules for authorizedUsers collection
    match /authorizedUsers/{userId} {
      allow read: if true;
      allow write: if isGestor();
    }

    // Default rule for all other documents
    match /{document=**} {
      allow read, write: if isAuthorizedUser();
    }
  }
}


